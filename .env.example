# bootstrap.sh copies this file to .env verbatim, so every uncommented line here
# has to be a working default. Anything needing a value from you stays commented
# out — an active line with a placeholder in it reads as configured and fails
# later, at runtime, somewhere else.

# Both lanes drive the Claude Code CLI through the Agent SDK, so `claude login`
# is the whole credential story and nothing bills per token. No API key needed.
#
# Setting one is opt-in, and it opts you into per-token billing: an explicit
# ANTHROPIC_API_KEY outranks the Claude Code login, and the SDK's child
# processes inherit this environment. DEEP_LANE_AUTH decides what happens to it.
# ANTHROPIC_API_KEY=sk-ant-...

# What the app does with ANTHROPIC_API_KEY, if you set one:
#   subscription  (default) — remove it from the environment at startup so both
#                             lanes fall through to the Claude Code login.
#   api                     — leave it alone; both lanes bill per-token to it.
DEEP_LANE_AUTH=subscription

# Fast-lane model. Anything the Claude Code CLI accepts — the CLI owns that
# list, and an unknown name fails when the session opens rather than
# misbehaving quietly. Haiku is the default because this lane is latency-bound.
BIRD_BRAIN_FAST_MODEL=claude-haiku-4-5

# STT backend: "local" (default) or "deepgram".
# local = faster-whisper on this machine: no key, no per-hour cost, no audio
# leaves the box. Deepgram is lower-latency but cloud, metered, and needs the
# key below — startup refuses the combination without it.
STT_BACKEND=local
# DEEPGRAM_API_KEY=...

# faster-whisper size: tiny.en | base.en | small.en | medium.en | large-v3.
# Raise it if proper nouns come back consistently mangled.
BIRD_BRAIN_WHISPER_MODEL=base.en

# Trigger FIFO — must match the command in your desktop custom shortcut
BIRD_BRAIN_FIFO=/tmp/bird_brain.fifo

# Plain-text file of your background / knowledge base the fast lane answers from
BIRD_BRAIN_RESUME=./prompts/background.txt

# How much transcript tail the lanes receive (characters)
BIRD_BRAIN_WINDOW_CHARS=4000
