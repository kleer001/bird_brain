# Claude API key — used by the fast lane (Messages API), always per-token.
# Leave blank to fall back to an `ant auth login` profile instead.
ANTHROPIC_API_KEY=sk-ant-...

# Which credential the DEEP lane (Claude Agent SDK / Claude Code) uses:
#   subscription  (default) — strip ANTHROPIC_API_KEY from the environment so
#                             Claude Code uses its own login. Run `claude login`
#                             once first. Deep-lane turns don't hit API credit.
#   api                     — leave the environment alone; both lanes bill
#                             per-token to ANTHROPIC_API_KEY.
DEEP_LANE_AUTH=subscription
# Fast-lane model: claude-opus-5 (default) or claude-haiku-4-5.
# Not just a model swap — each takes a different request shape, and the wrong
# one is a 400: opus-5 takes effort + explicit thinking-off, haiku-4-5 rejects
# effort outright and wants both fields omitted. src/fast_lane.py holds the
# shapes; startup refuses a model that isn't in that table.
# Haiku also raises the prompt-cache floor from 512 to 4096 tokens, so
# BIRD_BRAIN_RESUME must be ~8x larger or nothing caches (startup says so).
BIRD_BRAIN_FAST_MODEL=claude-opus-5


# Speech-to-text. Omit if STT_BACKEND=local.
DEEPGRAM_API_KEY=...

# STT backend: "deepgram" (default) or "local"
STT_BACKEND=deepgram

# Trigger FIFO — must match your GNOME custom shortcut command
BIRD_BRAIN_FIFO=/tmp/bird_brain.fifo

# Plain-text file of your background / knowledge base the fast lane answers from
BIRD_BRAIN_RESUME=./resume.txt

# How much transcript tail the lanes receive (characters)
BIRD_BRAIN_WINDOW_CHARS=4000
